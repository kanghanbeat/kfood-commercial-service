NEXT_PUBLIC_SITE_URL=https://kfood.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Keep empty/false for production so placeholder data cannot appear
# when Supabase is unavailable. Use true only for local demos without Supabase.
NEXT_PUBLIC_ALLOW_ALPHA_FALLBACK=

# 개발용 어드민 미리보기. true 면 로컬에서 로그인 없이 /admin 열람 가능.
# 프로덕션(NODE_ENV=production)에선 코드 가드로 무시됨. 운영 배포엔 절대 set 금지.
ADMIN_PREVIEW=

# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt used to hash IP/User-Agent for report rate limiting.
# Set a long random value in deployment. Do not expose as NEXT_PUBLIC_*.
REPORT_RATE_LIMIT_SALT=
